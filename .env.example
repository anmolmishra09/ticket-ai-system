# Copy to .env and replace every value. Never commit .env.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=support_ticket_db
DB_USERNAME=support_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_secure_secret_of_at_least_32_chars
JWT_EXPIRATION=900000

# Leave empty to run with fallback classification only
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
